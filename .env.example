# Development needs none of this. In production, set the variables marked REQUIRED in your host's dashboard.
# Never commit real values. Leave a variable out entirely to use its default;
# a blank value (VAR=) is not the same as unset and will fail validation.

# ── PUBLIC (exposed to the browser) ─────────────────────────────
# Canonical https origin. REQUIRED in production.
# NEXT_PUBLIC_SITE_URL=https://musicbox.example
# Shown on /terms, /privacy and /copyright; copyright notices and data requests arrive here. REQUIRED in production.
# NEXT_PUBLIC_CONTACT_EMAIL=hello@musicbox.example
# Set to "true" once a lawyer has reviewed /terms, /privacy and /copyright. Until then they show a "draft" notice.
# NEXT_PUBLIC_LEGAL_REVIEWED=true

# ── SERVER-ONLY ─────────────────────────────────────────────────
# Persistent, writable directory for the data store (mounted volume). REQUIRED in production.
# DATA_DIR=/var/lib/musicbox
# Comma-separated usernames with moderator/admin rights (the ONLY admin source in production).
# ADMIN_USERNAMES=you
# Header your platform sets with the real client IP. REQUIRED in production.
# Vercel: x-real-ip · Cloudflare: cf-connecting-ip · Fly.io: fly-client-ip · nginx: x-real-ip (configure it)
# CLIENT_IP_HEADER=x-real-ip

# Music catalogue. MusicBrainz is the default; songs imported earlier from iTunes keep working either way.
# METADATA_PROVIDER=musicbrainz            # or "itunes"
# MusicBrainz's rules require a way to contact you; it is sent in the User-Agent. REQUIRED in production.
# MUSICBRAINZ_CONTACT=hello@musicbox.example
# The public server allows 1 request/second. Point these at your own mirror when you outgrow it:
# MUSICBRAINZ_URL=https://musicbrainz.internal.example/ws/2
# MUSICBRAINZ_MIN_INTERVAL_MS=1100

# Optional: server errors are POSTed here as JSON ({ text, ...fields }): a Slack-compatible webhook, GlitchTip, etc.
# ERROR_WEBHOOK_URL=https://hooks.example.com/services/...

# Dev only: set to "false" to start without the demo community. Rejected in production.
# SEED_DEMO_DATA=false
