# Copy to .env.local (dev) or set in your host's dashboard (production).
# Never commit real values. MusicBox currently needs NO third-party secrets.

# ── PUBLIC (exposed to the browser) ─────────────────────────────
# Canonical https origin. Required in production.
NEXT_PUBLIC_SITE_URL=

# ── SERVER-ONLY ─────────────────────────────────────────────────
# Persistent, writable directory for the data store (mounted volume). Required in production.
DATA_DIR=
# Comma-separated usernames with moderator/admin rights (the ONLY admin source in production).
ADMIN_USERNAMES=
# Header your platform sets with the real client IP. Required in production.
# Vercel: x-real-ip · Cloudflare: cf-connecting-ip · Fly.io: fly-client-ip · nginx: x-real-ip (configure it)
CLIENT_IP_HEADER=
# Dev only: set to "false" to start without the demo community. Rejected in production.
SEED_DEMO_DATA=
